# NOTE: www -> apex cannot be done here (Pages ignores host-based sources).
# It is a Cloudflare dashboard Redirect Rule on the thomascabellmd.com zone.
# Every page also carries a canonical tag pointing at the apex.

# Links Doc has sent out with a capital N; the real page is lowercase
/Nuropod  /nuropod  301
/NUROPOD  /nuropod  301

# Retired draft addresses -> the published pages
/drafts/privacy  /privacy  301
/drafts/terms    /terms    301

# Social bio links -> the booking page, tagged with where the visitor came
# from. /book reads ?from=, keeps it for the session, and removes it from the
# address bar (src/lib/socialSource.ts). 302 so these can change later.
/instagram  /book?from=instagram  302
/facebook   /book?from=facebook   302
/youtube    /book?from=youtube    302
/ig         /book?from=instagram  302
/fb         /book?from=facebook   302
/yt         /book?from=youtube    302
