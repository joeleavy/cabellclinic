# Contact form backend — the Cloudflare Worker in workers/contact-email/.
# After `npm run worker:deploy` this is the worker's URL, e.g.
#   https://cabell-contact-email.<your-subdomain>.workers.dev
# For local development run `npm run worker:dev` and use:
#   http://localhost:8787
# Must also be set in the Cloudflare Pages project's environment variables
# (Production scope) so deployed builds get it.
VITE_CONTACT_ENDPOINT=

# Google Ads conversion tracking (optional). Unset = no Google tag at all, and
# the cookie bar is the informational "essential cookies only" version.
# Tag ID from Google Ads (Admin -> Google tag), e.g. AW-123456789.
VITE_GOOGLE_TAG_ID=
# Conversion action label, e.g. AW-123456789/AbCdEfGhIjKlMnOp (optional).
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Cloudflare Turnstile (bot check on the forms). The production site key is
# hardcoded in src/lib/turnstile.ts; set this only to override it locally,
# e.g. with Cloudflare's always-passes test key 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
